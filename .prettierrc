{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "overrides": [{ "files": "*.ejs", "options": { "parser": "html" } }],
  "importOrder": ["<THIRD_PARTY_MODULES>", "^@(.*)*", "^.+/(.*)$"],
  "importOrderSeparation": true,
  "plugins": ["@trivago/prettier-plugin-sort-imports"]
}
