<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Integration Bee - 1v1</title>
    <%- include("../components/styles") %>
    <link rel="stylesheet" type="text/css" href="/room.css" />
  </head>
  <%- include("../components/header.ejs") %>
  <div class="container">
    <h1>Room - <%= id %></h1>
  </div>
  <script
    id="MathJax-script"
    async
    src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"
  />
  <script>
    MathJax = {
      tex: {
        inlineMath: [["$", "$"]],
        displayMath: [["$$", "$$"]],
      },
      svg: {
        fontCache: "global",
      },
    };
  </script>
  <script src="/queue-bundle.js"></script>
</html>
