<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Integration Bee - 1v1</title>
    <%- include("../components/styles") %>
    <link rel="stylesheet" type="text/css" href="/room.css" />
  </head>
  <%- include("../components/header.ejs") %>
  <div class="container">
    <div class="top">
      <div class="progress-container">
        <div id="progress-bar"></div>
      </div>
      <span style="margin-left: 0.5em">
        <div id="player-ratings">
          <span>
            <%- include("../components/rating.ejs", {text: player.username, rating: player.rating})
            %> (<%= player.rating %>) vs. <%- include("../components/rating.ejs", {text:
            opponent.username, rating: opponent.rating}) %> (<%= opponent.rating %>)
          </span>
        </div>
        <div id="rating-change" hidden>
          <b>Win: <span id="rating-win"></span></b>
          <b>Lose: <span id="rating-lose"></span></b>
        </div>
      </span>
    </div>
    <div class="main">
      <span>
        <h2 id="round-display">Round #<%= game.round %></h2>
        <div class="problem">
          <div id="problem-content"></div>
        </div>
      </span>
      <form id="answer-form">
        <math-field id="answer-input"></math-field>
        <button type="submit">Submit</button>
      </form>
    </div>
    <div class="footer">
      <div class="score-display">
        <p>
          <b>Score:</b>
          <span class="score">
            <span id="pscore1"><%= game.score.first %></span>
          </span>
          -
          <span class="score">
            <span id="pscore2"><%= game.score.second %></span>
          </span>
        </p>
        <p><b>First to 2 wins!</b></p>
      </div>
    </div>
    <div id="game-result" hidden>
      <p id="winner"></p>
      <a href="/ranked">Play again?</a>
    </div>
  </div>

  <script src="/room-bundle.js"></script>
  <%- include("../components/mathjax.ejs") %>
  <script>
    setInterval(() => {
      MathJax.typesetPromise();
    }, 2000);
  </script>
</html>
