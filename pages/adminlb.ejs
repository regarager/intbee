<html>
  <head>
    <title>Integration Bee Scoreboard</title>
    <link rel="stylesheet" href="styles.css" />
  </head>

  <h2>User Editor</h2>
  <form id="form">
    <label for="name-input">Name: </label>
    <input type="text" id="name-input" />
    <label for="action-input">Action: </label>
    <select id="action-input">
      <option value="add">Add</option>
      <option value="remove">Remove</option>
    </select>
    <button type="submit">Submit</button>
  </form>

  <button id="save">Save</button>
  <button id="load">Load</button>

  <table>
    <thead>
      <tr>
        <td>ID</td>
        <td>Name</td>
        <td class="problem">Score</td>
        <td class="problem">Submissions</td>
        <td class="problem">1</td>
        <td class="problem">2</td>
        <td class="problem">3</td>
        <td class="problem">4</td>
        <td class="problem">5</td>
        <td class="problem">6</td>
        <td class="problem">7</td>
        <td class="problem">8</td>
        <td class="problem">9</td>
        <td class="problem">10</td>
        <td class="problem">11</td>
        <td class="problem">12</td>
        <td class="problem">13</td>
        <td class="problem">14</td>
        <td class="problem">15</td>
        <td class="problem">16</td>
        <td class="problem">17</td>
      </tr>
    </thead>
    <tbody id="tbody">
      <tr></tr>
    </tbody>
  </table>

  <script src="admin.js"></script>
</html>
