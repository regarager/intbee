<html>
  <head>
    <meta charset="utf-8" />
    <title>Integration Bee Scoreboard</title>
    <%- include("../components/styles") %>
    <link rel="stylesheet" type="text/css" href="/lbinstance.css" />
  </head>
  <%- include("../components/header.ejs") %>
  <div class="container" data-id="<%= id %>">
    <h2>User Editor</h2>
    <form id="form">
      <label for="name-input">Name: </label>
      <input type="text" id="name-input" />
      <label for="action-input">Action: </label>
      <select id="action-input">
        <option value="add">Add</option>
        <option value="remove">Remove</option>
      </select>
      <button type="submit">Submit</button>
    </form>

    <button id="save">Save</button>
    <button id="load">Load</button>

    <table>
      <thead>
        <tr>
          <td>ID</td>
          <td>Name</td>
          <td class="problem">Score</td>
          <td class="problem">Submissions</td>
          <% for (let i = 0; i < instance.size; i++) { %>
          <td class="problem"><%= i + 1 %></td>
          <% } %>
        </tr>
      </thead>
      <tbody id="tbody">
        <tr></tr>
      </tbody>
    </table>
  </div>
  <script src="/lb_admin-bundle.js"></script>
</html>
