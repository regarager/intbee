<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Integration Bee - Problem View</title>
    <%- include("../components/styles") %>
    <link rel="stylesheet" type="text/css" href="/problem.css" />
  </head>
  <%- include("../components/header.ejs") %>
  <div class="container">
    <h1>Problem View</h1>
    <div class="problem">$$<%= problem.latex %>d<%= problem.variable %>$$</div>
    <div class="problem-info">
      <p class="rating">
        <b>Rating:</b> <span class="c-<%= getRank(problem.rating) %>"><%= problem.rating %></span>
      </p>
      <div class="tags">
        <b>Tags: &ThinSpace;</b>
        <% for (const tag of problem.tags) { %>
        <div class="tag"><%= tag %></div>
        <% } %>
      </div>
      <div class="solution">
        <b>Solution:</b> <button id="show-sol">(click to reveal)</button>
        <span id="problem-solution" hidden>$$<%= problem.answer %>$$</span>
      </div>
      <form id="submission">
        <label for="answer"><b>Answer:</b></label>
        <input type="text" name="answer" id="answer-input" />
        <button type="submit" id="submit-btn">Submit</button>
      </form>
      <b id="result" hidden></b>
    </div>
    <script src="/problem-bundle.js"></script>
    <script
      id="MathJax-script"
      async
      src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"
    />
    <script>
      MathJax = {
        tex: {
          inlineMath: [["$", "$"]],
          displayMath: [["$$", "$$"]],
        },
        svg: {
          fontCache: "global",
        },
      };
    </script>
  </div>
</html>
