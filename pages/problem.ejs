<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Integration Bee - Gym</title>
    <%- include("../components/styles") %>
    <link rel="stylesheet" type="text/css" href="/problem.css">
  </head>
  <body>
    <h1>Problem View</h1>
    <div class="container">
      <div class="problem">
        $$<%= problem.latex %>d<%= problem.variable %>$$
      </div>
      <div class="problem-info">
        <p class="rating"><b>Rating:</b> <span class="c-<%= getRank(problem.rating) %>"><%= problem.rating %></span></p>
        <div class="tags"><b>Tags: &ThinSpace;</b>
        <% for (const tag of problem.tags) { %>
        <div class="tag"><%= tag %></div>
        <% } %>
      </div>
    </div>

  </body>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"/>
  <script>
     MathJax = {
          tex: {
              inlineMath: [['$', '$']],
     displayMath: [["$$", "$$"]]
          },
          svg: {
              fontCache: 'global'
          }
      };
  </script>
</html>

