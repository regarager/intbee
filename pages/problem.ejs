<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Integration Bee - Problem View</title>
    <%- include("../components/styles") %>
    <link rel="stylesheet" type="text/css" href="/problem.css" />
  </head>
  <%- include("../components/header.ejs") %>
  <div class="container">
    <h1>Problem View</h1>
    <div class="problem">$$<%= problem.latex %>d<%= problem.variable %>$$</div>
    <div class="problem-info">
      <span id="top">
        <p class="rating">
          <b>Rating:</b> <%- include("../components/rating.ejs", {rating: problem.rating}) %>
        </p>
        <% if (user && user.role === "admin") { %>
        <button onclick="window.location.href = '/admin/problem/<%= problem.id %>';">
          Edit Problem
        </button>
        <% } %>
      </span>

      <div class="tags">
        <b>Tags: &ThinSpace;</b>
        <% for (const tag of problem.tags) { %>
        <div class="tag"><%= tag %></div>
        <% } %>
      </div>
      <div class="solution">
        <b>Solution:</b>
        <button
          id="show-sol"
          hx-get="/api/problem/<%= problem.id %>/solution"
          hx-target="#problem-solution"
          hx-swap="innerHTML"
        >
          (click to reveal)
        </button>
        <span id="problem-solution"></span>
      </div>
      <form
        id="submission"
        hx-post="/api/problem/<%= problem.id %>/verify"
        hx-vals='js:{ latex: document.getElementById("answer-input").value }'
        hx-target="#result"
        hx-swap="innerHTML"
        hx-indicator="#submit-btn"
      >
        <label for="answer"><b>Answer:</b></label>
        <math-field id="answer-input" name="answer"></math-field>
        <button type="submit" id="submit-btn">Submit</button>
      </form>
      <b id="result"></b>
    </div>
    <script>
      document.addEventListener("htmx:afterSwap", function (evt) {
        MathJax.typesetPromise();
      });
    </script>
    <%- include("../components/mathjax.ejs") %>
  </div>
</html>
