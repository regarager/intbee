<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Integration Bee - Gym</title>
    <%- include("../components/styles") %>
    <link rel="stylesheet" type="text/css" href="/gym.css">
  </head>
  <%- include("../components/header.ejs") %>
  <div class="container">
    <h1>Gym</h1>
    <div id="problem-grid">
      <% for (const problem of problems) { %>
        <div class="problem">
          <a class="latex-container" href="/gym/problem/<%= problem.id %>">
            <p class="latex">$$<%= problem.latex %> d<%= problem.variable %>$$</p>
          </a>
        <div class="problem-info">
          <p class="rating">
            <b>Rating:</b>
            <%- include("../components/rating.ejs", { rating: problem.rating }) %>
          </p>
          <div class="tags"><b>Tags: &ThinSpace;</b>
          <% for (const tag of problem.tags) { %>
          <div class="tag"><%= tag %></div>
          <% } %>
        </div></div>
        </div>
      <% } %>
    </div>
  </div>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"/>
  <script>
     MathJax = {
          tex: {
              inlineMath: [['$', '$']],
     displayMath: [["$$", "$$"]]
          },
          svg: {
              fontCache: 'global'
          }
      };
  </script>
</html>

