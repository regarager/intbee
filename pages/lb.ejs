<html>
  <head>
    <meta charset="utf-8" />
    <title>Integration Bee Scoreboard</title>
    <%- include("../components/styles") %>
    <link rel="stylesheet" type="text/css" href="/lb.css" />
  </head>
  <%- include("../components/header.ejs") %>
  <div class="container">
    <h1>Leaderboard Tool Setup</h1>
    <form hx-post="/lb/new" hx-indicator="#submit-btn">
      <label for="size">Number of questions:</label>
      <input name="size" type="number" />
      <label for="size">Score values (separate by commas, ex: 1, 1, 2, 2):</label>
      <input name="score_values" />
      <label for="admins">Admin usernames (able to enter data; separate entries by commas):</label>
      <input name="admins" />
      <button type="submit">Create</button>
    </form>
  </div>
</html>
