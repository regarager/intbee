<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Integration Bee - Problem View</title>
    <%- include("../components/styles") %>
    <link rel="stylesheet" type="text/css" href="/problem-admin.css" />
  </head>
  <%- include("../components/header.ejs") %>
  <div class="container">
    <h1>Problem View - Admin</h1>
    <div id="split">
      <span id="left">
        <div class="problem">$$<%= problem.latex %>d<%= problem.variable %>$$</div>
      </span>
      <span id="right">
        <form class="problem-info" id="editor">
          <label for="integral"><b>Integral:</b></label>
          <math-field name="integral" value="<%= problem.latex %>"></math-field>
          <p class="note">Do not include the dx</p>
          <label for="rating"><b>Rating:</b></label>
          <input type="number" value=<%= problem.rating %> name="rating" />
          <label><b>Tags: &ThinSpace;</b></label>
          <input name="tags" type="text" value="<%= problem.tags.join(',') %>" />
          <label for="answer"><b>Solution:</b></label>
          <math-field name="answer" value="<%= problem.answer %>"></math-field>
          <button type="submit" id="submit-btn">Update</button>
          <p><b>ID:</b> <%= problem.id %></p>
        </form>
    </div>
  </div>
  <script src="/problem_admin-bundle.js"></script>
  <%- include("../components/mathjax.ejs") %>
  <script>
    setInterval(() => {
      MathJax.typesetPromise();
    }, 1000);
  </script>
  </div>
</html>
