<% const { rating = 0, text = rating.toString() } = locals; const message = text; const rank =
getRank(rating); %> <% if (rank === "orz") { %>
<span class="c-orz-first-letter"><%= message[0] %></span
><span class="c-orz"><%= message.slice(1) %></span>
<% } else { %>
<span class="c-<%= rank %>"><%= message %></span>
<% } %>
